PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Resend Email OTP Service Configuration
# Obtain your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Configured sender email: use 'Portfolio Security <onboarding@resend.dev>' for free testing
# or your verified custom domain address e.g. 'Security <security@yourdomain.com>'
RESEND_FROM_EMAIL=Portfolio Security <onboarding@resend.dev>
